{
  "name": "@autono/open-pages",
  "version": "0.1.0",
  "description": "Runtime and CLI for open-pages \u2014 live preview of React and HTML pages, click-to-comment inspector, and static export.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./locale": {
      "types": "./dist/locale/index.d.ts",
      "import": "./dist/locale/index.js"
    },
    "./env": {
      "types": "./env.d.ts"
    }
  },
  "bin": {
    "open-pages": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "env.d.ts",
    "src/app",
    "src/locale",
    "src/shared",
    "skills",
    "README.md",
    "workspace"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test:e2e": "pnpm run build && playwright test",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "pages",
    "website",
    "landing-page",
    "react",
    "vite",
    "agents",
    "tailwind",
    "html"
  ],
  "license": "MIT",
  "author": {
    "name": "autonoco",
    "url": "https://github.com/autonoco"
  },
  "homepage": "https://openpages.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autonoco/open-pages.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/autonoco/open-pages/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/types": "^8.0.6",
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "chalk": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^15.0.0",
    "emoji-picker-react": "^4.22.2",
    "fast-glob": "^3.3.2",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "use-sync-external-store": "^1.7.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
