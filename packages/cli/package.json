{
  "name": "@autono/create-open-pages",
  "version": "0.1.0",
  "description": "Scaffold an open-pages workspace — agent skills preconfigured, live real-PDF preview out of the box.",
  "type": "module",
  "bin": {
    "create-open-pages": "dist/cli.js"
  },
  "files": [
    "dist",
    "template",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/sync-template-skills.mjs && tsdown",
    "typecheck": "tsc --noEmit",
    "sync:template-skills": "node scripts/sync-template-skills.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "pdf",
    "pages",
    "claude-code",
    "agents",
    "scaffold"
  ],
  "license": "MIT",
  "author": {
    "name": "autonoco",
    "url": "https://github.com/autonoco"
  },
  "homepage": "https://openpages.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autonoco/open-pages.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/autonoco/open-pages/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/prompts": "^2.4.9",
    "tsdown": "^0.9.9",
    "typescript": "^5.9.3"
  }
}
